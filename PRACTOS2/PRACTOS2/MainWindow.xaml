<Window x:Class="PRACTOS2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PRACTOS2"
        mc:Ignorable="d"
        Title="практическая 2 варик 9 " Height="450" Width="800">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="файл">
                <MenuItem Header="открыть" Click="open_Click"/>
                <MenuItem Header="сохранить" Click="save_click"/>
                <MenuItem Header="выход" Click="exit_click"/>
            </MenuItem>
            <MenuItem Header="справка">
                <MenuItem Header="о программе" Click="info_clic"/>
            </MenuItem>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Width="788" Height="32" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock Text="Количество элементов - " Height="19" />
            <TextBox x:Name="txtELEMENT" Width="40" Height="19" />
            <TextBlock Text="Диапазон от (1) - (100) " Height="19" Margin="15,0,0,0"/>
            <TextBox x:Name="txtDIAPAZONE" Width="40" Height="19"/>
            <Button Content="Заполнить" Click="zapolnit_click" Height="19" Margin="19,0,0,0"/>
            <Button Content="Рассчитать" Click="raschitat_click" Height="19" Margin="10,0,0,0"/>
            <Button Content="Очистить" Click="clear_click" Height="19" Margin="10,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="DataGrid" 
          Margin="10" 
          Width="472" 
          HorizontalAlignment="Left" CellEditEnding="DataGrid_CellEditEnding"/>
        <StackPanel Margin="10">
            <TextBlock Text="Произведение (*) = " Margin="10" Width="111" Foreground="#FF2F583F"/>
            <TextBlock x:Name="txtREZULTAT" Height="107"/>
        </StackPanel>

    </DockPanel>

</Window>
